{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "spai-tup-angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "spai",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/spai-tup-angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1.25MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "index": "src/index.local.html",
              "outputPath": "dist/spai-tup-local"
            },
            "lan": {
              "index": {
                "input": "src/index.lan.html",
                "output": "index.html"
              },
              "outputPath": "dist/spai-tup-lan",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.lan.ts"
                }
              ]
            },
            "isolated": {
              "index": "src/index.local.html",
              "outputPath": "dist/spai-tup-isolated",
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.isolated.ts"
                }
              ]
            },
            "local": {
              "index": "src/index.local.html",
              "outputPath": "dist/spai-tup-local",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "complement": {
              "index": "src/index.local.html",
              "outputPath": "dist/spai-tup-complement",
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.complement.ts"
                }
              ]
            },
            "tunnel": {
              "index": {
                "input": "src/index.tunnel.html",
                "output": "index.html"
              },
              "outputPath": "dist/spai-tup-tunnel",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.tunnel.ts"
                }
              ]
            },
            "preproduction": {
              "index": "src/index.preproduction.html",
              "outputPath": "dist/spai-tup-preproduction",
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.preproduction.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "isolated": {
              "buildTarget": "spai-tup-angular:build:isolated"
            },
            "production": {
              "buildTarget": "spai-tup-angular:build:production"
            },
            "development": {
              "buildTarget": "spai-tup-angular:build:development"
            },
            "local": {
              "buildTarget": "spai-tup-angular:build:local"
            },
            "complement": {
              "buildTarget": "spai-tup-angular:build:complement"
            },
            "preproduction": {
              "buildTarget": "spai-tup-angular:build:preproduction"
            }
          },
          "defaultConfiguration": "local"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
