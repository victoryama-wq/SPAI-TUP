    allow read: if active() && resource.data.recipient == request.auth.uid;
    allow update: if active() && resource.data.recipient == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
    allow create, delete: if false;
  }
  function globalCatalog(key) { let u = user(); return hasModule(u, key, false) && (u.get('baseRole', '') in ['ADMIN_GENERAL', 'COORDINACION_ACADEMICA', 'ALTA_DOCENTES'] || u.get('scope', {}).get('programs', []).hasAny(['*'])); }
  function catalogRead(key, program) { let u = user(); return hasModule(u, key, false) && (u.get('baseRole', '') in ['ADMIN_GENERAL', 'COORDINACION_ACADEMICA', 'ALTA_DOCENTES'] || u.get('scope', {}).get('programs', []).hasAny(['*', program])); }
  // Server-owned cycle fence is read in the atomic Rules evaluation of each write.
  function currentCycle() {
    let ref = /databases/$(database)/documents/ciclo_control/operativo;
    let control = exists(ref) ? get(ref).data : {};
    return control.get('state','') == 'READY' ? control : {};
  }
  function captureOpen(code) { let c=currentCycle(); return c.get('code','_none') == code && c.get('status','') == 'Captura'; }
  function teacherCapture() { let c=currentCycle(); return c.get('status','') == 'Captura' && inCycle(c.get('code','_none')); }
  function admittedSpecialGroup(d) {
    let groupId = d.get('group','').replace('[^A-Z0-9]+', '_');
    let path = /databases/$(database)/documents/grupos/$(groupId);
    let g = exists(path) ? get(path).data : {};
    return g.get('fullGroup','_none') == d.get('group','') && g.get('cycleCode','_none') == d.get('cycle','')
      && g.get('status','') == 'Activo' && !(g.get('modality','') in ['Escolarizado','Ejecutivo'])
      && g.get('section','').matches('(?i).*C[.]A[.]?');
  }
  function assignmentCapture(d) {
    let c=currentCycle();
    return c.get('code','_none') == d.get('cycle','') && ((c.get('status','') == 'Captura' && (d.get('assignmentType','') != 'ESPECIAL' || admittedSpecialGroup(d)))
      || (c.get('status','') == 'Captura cerrada' && c.get('specialsEnabled',false) == true
          && d.get('assignmentType','') == 'ESPECIAL' && admittedSpecialGroup(d) && d.get('group','') in c.get('specialGroups',[]) && d.get('sharedGroups',[]).hasOnly(c.get('specialGroups',[]))));
  }
  function retainedCycle(d) {
    let code = d.get('cycle', d.get('cycleCode', ''));
    let id = d.get('cycleId', d.get('entity', '') == 'ciclos' ? d.get('entityId', '') : '');
    return (code == '' || !exists(/databases/$(database)/documents/ciclos_retirados/$('code_' + code)))
