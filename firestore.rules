    let own = resource.data.get('createdBy', '') == request.auth.uid || (role != 'ALTA_DOCENTES' && safeList(resource.data, 'assignedCoordinatorIds').hasAny([request.auth.uid]));
    let adminScope = role == 'ADMIN_GENERAL' || (role == 'ADMIN_OPERATIVO' && s.get('teachers', []).hasAny(['*', id]));
    let ordinary = teacherCapture() && hasModule(u, 'docentes', true) && (adminScope || (role != 'ADMIN_OPERATIVO' && own)) && (role != 'ADMIN_OPERATIVO' || s.get('fields', []).hasAny(['*']) || keys.hasOnly(s.get('fields', []).concat(['updatedAt', 'updatedBy', 'updatedByName', 'updatedByRole']))) && resource.data.get('status', '') in ['PENDIENTE', 'VALIDADO'] && teacherFields();
    let sensitive = hasModule(u, 'docentes', true) && adminScope && (role == 'ADMIN_GENERAL' || (u.get('capabilities', []).hasAny(['VALIDATE_TEACHERS']) && (s.get('fields', []).hasAny(['*']) || keys.hasOnly(s.get('fields', []).concat(['updatedAt', 'updatedBy', 'updatedByName', 'updatedByRole']))))) && keys.hasOnly(['status', 'lifecycleStatus', 'validatedBy', 'validatedAt', 'inactivatedBy', 'inactivatedAt', 'assignedCoordinatorIds', 'assignedCoordinatorNames', 'updatedAt', 'updatedBy', 'updatedByName', 'updatedByRole']);
    return valid(u) && (ordinary || sensitive);
  }
  function teacherRead(id) {
    let u = user(); let role = u.get('baseRole', ''); let teachers = safeList(safeMap(u, 'scope'), 'teachers');
    return hasModule(u, 'docentes', false) && (role == 'ADMIN_OPERATIVO' ? (teachers.hasAny(['*']) || (id in teachers)) : (role in ['ADMIN_GENERAL', 'COORDINACION_ACADEMICA', 'ALTA_DOCENTES'] ||
