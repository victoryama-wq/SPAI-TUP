    return ((assignmentCapture(d) && assignmentCapture(n)) || (administrative && keys.hasOnly(['status','observations','updatedAt','updatedBy','updatedByName','updatedByRole']))) && !keys.hasAny(['cycle','assignmentType','special']) && hasModule(u, 'asignaciones', true) && loadedIdentity(d, n) && n.get('moodleId', '') == n.get('normalizedMoodleId', '') && n.get('createdBy', '') == d.get('createdBy', '') && n.get('createdAt', '') == d.get('createdAt', '')
