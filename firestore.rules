rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function legacyMapping(u, legacy) {
    let path = /databases/$(database)/documents/mapeos_permisos/$(request.auth.uid);
    let mapping = exists(path) ? get(path).data : {};
    return mapping.get('status', '') == 'ACTIVE' && mapping.get('version', '') == 'E2-R01-v0.4-1'
      && mapping.get('approvedBy', '') != '' && mapping.get('revision', -1) == legacy.get('mappingRevision', -2)
      && mapping.get('profileRevision', -1) == u.get('revision', 0) && mapping.get('baseRole', '') == legacy.get('baseRole', '_none');
  }
  function rawUser() {
    let u = signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data : {};
    let legacy = u.get('legacyAuthorization', {});
    return u.get('deletedAt', null) != null ? {} : u.get('permissionSchemaVersion', 0) == 2 ? u :
      (u.get('status', '') == 'Activo' && u.get('identityAliasOf', null) == null && legacy.get('mappingVersion', '') == 'E2-R01-v0.4-1' && legacy.get('profileRevision', -1) == u.get('revision', 0) && legacy.get('expiresAtMillis', 0) > request.time.toMillis() && legacyMapping(u, legacy) ? legacy : {});
  }
  function safeList(d, key) { return d.get(key, []) is list ? d.get(key, []) : []; }
  function safeMap(d, key) { return d.get(key, {}) is map ? d.get(key, {}) : {}; }
  function safeScope(s) { return {'programs': safeList(s, 'programs'), 'cycles': safeList(s, 'cycles'), 'teachers': safeList(s, 'teachers'), 'fields': safeList(s, 'fields')}; }
  function grantCurrent(grant) { return grant.get('expiresAtMillis', null) == null || (grant.get('expiresAtMillis', 0) is int && grant.get('expiresAtMillis', 0) > request.time.toMillis()); }
  function user() {
    let u = rawUser(); let id = u.get('delegationId', '_none') is string ? u.get('delegationId', '_none') : '_none';
    let path = /databases/$(database)/documents/delegaciones/$(id);
    let aux = u.get('baseRole', '') == 'ADMIN_OPERATIVO';
    let grant = aux && id is string && id != '_none' && exists(path) ? get(path).data : {};
    return !aux ? u : (grant.get('status', '') == 'ACTIVE' && grant.get('userId', '') == request.auth.uid && grantCurrent(grant)
      ? {'status': u.get('status', ''), 'permissionSchemaVersion': u.get('permissionSchemaVersion', 0),
         'identityAliasOf': u.get('identityAliasOf', null), 'baseRole': 'ADMIN_OPERATIVO', 'delegationId': id,
         'permissions': safeMap(grant, 'permissions'), 'scope': safeScope(safeMap(grant, 'scope')), 'capabilities': safeList(grant, 'capabilities')}
      : {});
  }
  function valid(u) { return signedIn() && u.get('status', '') == 'Activo' && u.get('permissionSchemaVersion', 0) == 2 && u.get('identityAliasOf', null) == null; }
  function active() { return valid(user()); }
  function general() { let u = user(); return valid(u) && u.get('baseRole', '') == 'ADMIN_GENERAL'; }
  function auxiliary() { let u = user(); return valid(u) && u.get('baseRole', '') == 'ADMIN_OPERATIVO'; }
  function delegation() { let grantId = user().get('delegationId', '_none'); return grantId != '_none' && exists(/databases/$(database)/documents/delegaciones/$(grantId)) ? get(/databases/$(database)/documents/delegaciones/$(grantId)).data : {}; }
  function grantActive(u) { let grantId = u.get('delegationId', '_none'); let grant = grantId != '_none' && exists(/databases/$(database)/documents/delegaciones/$(grantId)) ? get(/databases/$(database)/documents/delegaciones/$(grantId)).data : {}; return grant.get('status', '') == 'ACTIVE' && grant.get('userId', '') == request.auth.uid && grantCurrent(grant); }
  function delegated() { let u = user(); return valid(u) && u.get('baseRole', '') == 'ADMIN_OPERATIVO'; }
  function permissions() { return auxiliary() ? delegation().get('permissions', {}) : user().get('permissions', {}); }
  function hasModule(u, key, edit) {
    let role = u.get('baseRole', ''); let level = u.get('permissions', {}).get(key, 'NONE');
    return valid(u) && (role == 'ADMIN_GENERAL' || ((edit ? level == 'EDIT' : level in ['VIEW', 'EDIT'])));
  }
  function module(key, edit) { return hasModule(user(), key, edit); }
  function academic() { let u = user(); return valid(u) && u.get('baseRole', '') == 'COORDINACION_ACADEMICA'; }
  function systems() { let u = user(); return valid(u) && u.get('baseRole', '') in ['ADMIN_GENERAL', 'ADMIN_OPERATIVO']; }
  function scope() { return user().get('scope', {}); }
  function within(kind, value) { let u = user(); return u.get('baseRole', '') == 'ADMIN_GENERAL' || u.get('scope', {}).get(kind, []).hasAny(['*', value]); }
  function capability(key) {
