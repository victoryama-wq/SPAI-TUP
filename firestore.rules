  }
  function ordinaryAssignmentFields() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherMoodleUser', 'teacherName', 'group', 'program', 'shared', 'sharedGroups', 'sharedPrograms', 'studentEnrollments', 'updatedBy', 'updatedByName', 'updatedByRole', 'updatedAt']); }
  function enrollmentsOnly() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentEnrollments', 'updatedBy', 'updatedByName', 'updatedByRole', 'updatedAt']); }
  function loadedIdentity(d, n) { return !(d.get('status', '') in ['CARGADO_MOODLE', 'VALIDADO']) || !n.diff(d).affectedKeys().hasAny(['moodleId', 'normalizedMoodleId', 'subjectId', 'subjectName']); }
  function assignmentUpdate() {
