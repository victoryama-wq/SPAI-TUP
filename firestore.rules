rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isActiveUser() {
      return userDocExists()
        && currentUser().data.status == 'Activo';
    }

    function userRole() {
      return currentUser().data.role;
    }

    function isSystemsMember() {
      return isActiveUser()
        && userRole() is string
        && (
          userRole().matches('.*Sistemas.*')
          || userRole().matches('.*sistemas.*')
        );
    }

    function isSystemsCoordinator() {
      return isSystemsMember()
        && (
          userRole().matches('.*Coordinaci.*Sistemas.*')
          || userRole().matches('.*Coordinador.*Sistemas.*')
        );
    }

    function isAcademicCoordinator() {
      return isActiveUser()
        && userRole() is string
        && (
          userRole().matches('.*Acad.*')
          || userRole().matches('.*acad.*')
        )
        && !userRole().matches('.*Sistemas.*')
        && !userRole().matches('.*sistemas.*');
    }

    function hasModuleAccess(moduleKey) {
      return isActiveUser()
        && currentUser().data.access[moduleKey] == true;
    }

    function canReadInstitutionalCatalogs() {
      return isActiveUser();
    }

    function canReadUsersDirectory() {
      return isActiveUser();
    }

    function canManageUsers() {
      return isSystemsCoordinator()
        || (
          isSystemsMember()
          && hasModuleAccess('usuarios')
        );
    }

    function canEditCycles() {
      return isSystemsMember()
        && (
          hasModuleAccess('ciclos')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function canEditNomenclatures() {
      return isSystemsMember()
        && (
          hasModuleAccess('nomenclaturas')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function canEditGroups() {
      return isSystemsMember()
        && (
          hasModuleAccess('grupos')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function canEditTeachers() {
      return isSystemsMember()
        && (
          hasModuleAccess('docentes')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function canCreatePendingTeacher() {
      return isActiveUser()
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.origin == 'MANUAL'
        && request.resource.data.normalizedMoodleUser is string
        && request.resource.data.fullName is string
        && request.resource.data.moodleUser is string;
    }

    function canUpdateOwnPendingTeacher(teacherId) {
      return isActiveUser()
        && resource.data.status == 'PENDIENTE'
        && resource.data.origin == 'MANUAL'
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.origin == 'MANUAL'
        && teacherId == request.resource.data.normalizedMoodleUser;
    }

    function canDeleteOwnPendingTeacher(teacherId) {
      return isActiveUser()
        && hasModuleAccess('docentes')
        && resource.data.status == 'PENDIENTE'
        && resource.data.origin == 'MANUAL'
        && resource.data.lifecycleStatus == 'NUEVO'
        && teacherId == resource.data.normalizedMoodleUser
        && (
          resource.data.createdBy == request.auth.uid
          || (
            resource.data.createdBy is string
            && exists(/databases/$(database)/documents/usuarios/$(resource.data.createdBy))
            && get(/databases/$(database)/documents/usuarios/$(resource.data.createdBy)).data.authUid == request.auth.uid
          )
        );
    }

    function isBaseSystemsUser() {
      return isActiveUser()
        && userRole() in ['Coordinación de Sistemas', 'Auxiliar de Sistemas'];
    }

    function canEditSubjects() {
      return isSystemsMember()
        && (
          hasModuleAccess('asignaturas')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function canReadAssignments() {
      return isSystemsMember()
        || isAcademicCoordinator()
        || hasModuleAccess('asignaciones');
    }

    function canWriteAssignmentProgram(program) {
      return isSystemsMember()
        || (
          isAcademicCoordinator()
          && program is string
          && (
            (
              currentUser().data.assignedPrograms is list
              && currentUser().data.assignedPrograms.hasAny([program])
            )
            || (
              request.resource.data.createdBy == request.auth.uid
              && request.resource.data.createdByPrograms is list
              && request.resource.data.createdByPrograms.hasAny([program])
            )
            || isCurrentUserCoordinatorOfProgram(program)
          )
        );
    }

    function isCurrentUserCoordinatorOfProgram(program) {
      return program is string
        && exists(/databases/$(database)/documents/programas/$(program))
        && (
          get(/databases/$(database)/documents/programas/$(program)).data.coordinator == currentUser().data.name
          || get(/databases/$(database)/documents/programas/$(program)).data.coordinator == currentUser().data.email
          || get(/databases/$(database)/documents/programas/$(program)).data.coordinator == currentUser().data.authUid
          || get(/databases/$(database)/documents/programas/$(program)).data.coordinator == request.auth.uid
          || get(/databases/$(database)/documents/programas/$(program)).data.coordinator == request.auth.token.email
          || get(/databases/$(database)/documents/programas/$(program)).data.coordinator == request.auth.token.name
        );
    }

    function canWriteAssignmentPrograms(programs) {
      return isSystemsMember()
        || (
          isAcademicCoordinator()
          && programs is list
          && (
            (
              currentUser().data.assignedPrograms is list
              && currentUser().data.assignedPrograms.hasAny(programs)
            )
            || (
              request.resource.data.createdBy == request.auth.uid
              && request.resource.data.createdByPrograms is list
              && request.resource.data.createdByPrograms.hasAny(programs)
            )
          )
        );
    }

    function canWriteAssignment() {
      return canWriteAssignmentProgram(request.resource.data.program)
        || canCreateOwnNonEnglishAssignment();
    }

    function canChangeAssignmentProgram() {
      return request.resource.data.program == resource.data.program
        || isSystemsMember()
        || (
          canWriteAssignmentProgram(resource.data.program)
          && canWriteAssignmentProgram(request.resource.data.program)
        );
    }

    function canCreateOwnAssignment() {
      return isActiveUser()
        && isAcademicCoordinator()
        && request.resource.data.createdBy == request.auth.uid;
    }

    function canCreateOwnNonEnglishAssignment() {
      return canCreateOwnAssignment()
        && !isEnglishAssignmentProgram(request.resource.data.program);
    }

    function canWriteOwnAssignment() {
      return isActiveUser()
        && isAcademicCoordinator()
        && resource.data.createdBy == request.auth.uid;
    }

    function canWriteOwnNonEnglishAssignment() {
      return canWriteOwnAssignment()
        && !isEnglishAssignmentProgram(resource.data.program);
    }

    function isEnglishAssignmentProgram(program) {
      return program is string
        && ['ING', 'ING-FCS', 'INGLES', 'IDIOMAS', 'IDIOMA'].hasAny([program]);
    }

    function canDeleteAssignment() {
      return canWriteAssignmentProgram(resource.data.program)
        || canWriteOwnNonEnglishAssignment()
        || canWriteExistingSharedAssignmentFromSource();
    }

    function preservesExistingSharedGroups() {
      return !(resource.data.sharedGroups is list)
        || (
          request.resource.data.sharedGroups is list
          && request.resource.data.sharedGroups.hasAll(resource.data.sharedGroups)
        );
    }

    function preservesExistingSharedPrograms() {
      return !(resource.data.sharedPrograms is list)
        || (
          request.resource.data.sharedPrograms is list
          && request.resource.data.sharedPrograms.hasAll(resource.data.sharedPrograms)
        );
    }

    function canUpdateSharedAssignmentParticipation() {
      return canWriteAssignmentPrograms(resource.data.sharedPrograms)
        && preservesExistingSharedGroups()
        && preservesExistingSharedPrograms();
    }

    function canWriteExistingSharedAssignmentFromSource() {
      return resource.data.shared == true
        && resource.data.sourceAssignmentId is string
        && exists(/databases/$(database)/documents/asignaciones/$(resource.data.sourceAssignmentId))
        && canWriteAssignmentProgram(
          get(/databases/$(database)/documents/asignaciones/$(resource.data.sourceAssignmentId)).data.program
        );
    }

    // Coordinación Académica puede corregir docente, grupo base y matrículas
    // adicionales incluso después de cargar la asignación en Moodle. La materia,
    // el ID Moodle, el estado, los grupos compartidos y la trazabilidad siguen
    // protegidos para Sistemas.
    function changesOnlyAcademicAssignmentOperationalData() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'group',
        'program',
        'teacherMoodleUser',
        'teacherName',
        'shared',
        'sharedGroups',
        'sharedPrograms',
        'studentEnrollments',
        'updatedBy',
        'updatedByName',
        'updatedByRole',
        'updatedAt'
      ]);
    }

    function canAcademicCoordinatorUpdateAssignmentOperationalData() {
      return isAcademicCoordinator()
        && changesOnlyAcademicAssignmentOperationalData()
        && canWriteAssignmentProgram(resource.data.program)
        && canWriteAssignmentProgram(request.resource.data.program);
    }

    // Desde el catálogo global, Coordinación puede registrar únicamente
    // matrículas adicionales. No obtiene permisos sobre docente, grupos,
    // materia, ID Moodle, estado ni programas ajenos.
    function changesOnlyAcademicAssignmentEnrollments() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'studentEnrollments',
        'updatedBy',
        'updatedByName',
        'updatedByRole',
        'updatedAt'
      ]);
    }

    function canAcademicCoordinatorUpdateAnyAssignmentEnrollments() {
      return isAcademicCoordinator()
        && changesOnlyAcademicAssignmentEnrollments();
    }

    // Una vez cargada en Moodle, la identidad académica no se puede alterar
    // desde el cliente, ni siquiera por Sistemas. Sí permanecen editables los
    // datos operativos autorizados.
    function preservesLoadedAssignmentIdentity() {
      return !['CARGADO_MOODLE', 'VALIDADO'].hasAny([resource.data.status])
        || (
          request.resource.data.moodleId == resource.data.moodleId
          && request.resource.data.normalizedMoodleId == resource.data.normalizedMoodleId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.subjectName == resource.data.subjectName
        );
    }

    function canUpdateAssignmentDocument() {
      return isSystemsMember()
        || canAcademicCoordinatorUpdateAssignmentOperationalData()
        || canAcademicCoordinatorUpdateAnyAssignmentEnrollments()
        || (
          !isAcademicCoordinator()
          && (
            canUpdateSharedAssignmentParticipation()
            || canWriteOwnNonEnglishAssignment()
            || canWriteExistingSharedAssignmentFromSource()
          )
        );
    }

    function canReadMeetLinks() {
      return isSystemsMember()
        || hasModuleAccess('ligasMeet');
    }

    function canEditMeetLinks() {
      return isSystemsMember();
    }

    function canReadMoodleCatalogs() {
      return isSystemsMember()
        || hasModuleAccess('moodle');
    }

    function canEditMoodleCatalogs() {
      return isSystemsMember()
        && (
          hasModuleAccess('moodle')
          || userRole().matches('.*Sistemas.*')
        );
    }

    function isValidMeetLinkDocument(meetLinkId) {
      return request.resource.data.assignmentId == meetLinkId
        && request.resource.data.assignmentId is string
        && request.resource.data.cycle is string
        && request.resource.data.meetUrl is string
        && request.resource.data.status in [
          'PENDIENTE',
          'REVISADA',
          'GENERADA'
        ]
        && request.resource.data.observations is string
        && request.resource.data.createdBy is string
        && request.resource.data.createdByName is string
        && request.resource.data.createdByRole is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedByName is string
        && request.resource.data.updatedByRole is string
        && request.resource.data.updatedAt is string;
    }

    function changesAssignmentDeletionFields() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'deletedAt',
        'deletedBy',
        'deletedByName',
        'deletedByRole'
      ]);
    }

    function canReadSharedRequests() {
      return isSystemsMember()
        || isAcademicCoordinator()
        || hasModuleAccess('solicitudes');
    }

    function canCreateSystemRequest() {
      return isActiveUser()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.type in ['REABRIR_CAPTURA', 'ALTA_GRUPO', 'CAMBIAR_ID_ASIGNATURA', 'DOCENTE_NUEVO']
        && request.resource.data.title is string
        && request.resource.data.detail is string
        && request.resource.data.cycle is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function canReadAcademicNotificationTarget() {
      return resource.data.target == 'COORDINACION_ACADEMICA'
        && resource.data.targetUserId is string
        && (
          resource.data.targetUserId == request.auth.uid
          || (
            request.auth.token.email is string
            && resource.data.targetUserId == request.auth.token.email
          )
          || (
            isActiveUser()
            && currentUser().data.assignedPrograms is list
            && currentUser().data.assignedPrograms.hasAny([resource.data.targetUserId])
          )
        );
    }

    function isOwnBootstrapUser(userId) {
      return signedIn()
        && userId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.role == 'Pendiente de autorizacion'
        && request.resource.data.status == 'Inactivo'
        && request.resource.data.assignedPrograms is list
        && request.resource.data.assignedPrograms.size() == 0
        && request.resource.data.access is map
        && request.resource.data.access.dashboard == false
        && request.resource.data.access.usuarios == false
        && request.resource.data.access.ciclos == false
        && request.resource.data.access.nomenclaturas == false
        && request.resource.data.access.grupos == false
        && request.resource.data.access.docentes == false
        && request.resource.data.access.asignaturas == false
        && request.resource.data.access.asignaciones == false
        && request.resource.data.access.solicitudes == false
        && request.resource.data.access.ligasMeet == false
        && request.resource.data.access.moodle == false
        && request.resource.data.access.bitacora == false
        && request.resource.data.keys().hasOnly([
          'authUid',
          'name',
          'email',
          'role',
          'assignedPrograms',
          'access',
          'status',
          'createdAt',
          'updatedAt'
        ]);
    }

    function isOwnEmailBinding(userId) {
      return signedIn()
        && resource.data.authUid == null
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['authUid', 'updatedAt'])
        && request.resource.data.authUid == request.auth.uid;
    }

    match /usuarios/{userId} {
      allow read: if canReadUsersDirectory()
        || userId == request.auth.uid
        || resource.data.authUid == request.auth.uid
        || resource.data.email == request.auth.token.email;

      allow create: if canManageUsers()
        || isOwnBootstrapUser(userId);

      allow update: if canManageUsers()
        || isOwnEmailBinding(userId);

      allow delete: if canManageUsers();
    }

    match /roles_personalizados/{roleId} {
      allow read: if isActiveUser();
      allow create, update, delete: if canManageUsers();
    }

    match /ciclos/{cycleId} {
      allow read: if canReadInstitutionalCatalogs();
      allow create, update, delete: if canEditCycles();
    }

    match /programas/{programId} {
      allow read: if canReadInstitutionalCatalogs();
      allow create, update, delete: if canEditNomenclatures();
    }

    match /nomenclaturas_programas/{nomenclatureId} {
      allow read: if canReadInstitutionalCatalogs();
      allow create, update, delete: if canEditNomenclatures();
    }

    match /grupos/{groupId} {
      allow read: if canReadInstitutionalCatalogs();
      allow create, update, delete: if canEditGroups();
    }

    match /docentes/{teacherId} {
      allow read: if canReadInstitutionalCatalogs();

      allow create: if teacherId == request.resource.data.normalizedMoodleUser
        && (
          canEditTeachers()
          || canCreatePendingTeacher()
        );

      allow update: if canEditTeachers()
        || canUpdateOwnPendingTeacher(teacherId);

      allow delete: if (
          canEditTeachers()
          && resource.data.status == 'INACTIVO'
        )
        || canDeleteOwnPendingTeacher(teacherId);
    }

    match /asignaturas/{subjectId} {
      allow read: if canReadInstitutionalCatalogs();

      allow create: if canEditSubjects()
        && subjectId == request.resource.data.subjectId;

      allow update: if canEditSubjects()
        && request.resource.data.subjectId == resource.data.subjectId;

      allow delete: if canEditSubjects();
    }

    match /asignaciones/{assignmentId} {
      allow read: if canReadAssignments();

      allow create: if canWriteAssignment()
        && (
          isSystemsMember()
          || request.resource.data.createdBy == request.auth.uid
        )
        && request.resource.data.moodleId == request.resource.data.normalizedMoodleId
        && request.resource.data.cycle is string
        && request.resource.data.group is string
        && request.resource.data.subjectId is string
        && request.resource.data.teacherMoodleUser is string;

      allow update: if canUpdateAssignmentDocument()
        && canChangeAssignmentProgram()
        && preservesLoadedAssignmentIdentity()
        && request.resource.data.moodleId == request.resource.data.normalizedMoodleId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          !changesAssignmentDeletionFields()
          || canDeleteAssignment()
        );

      allow delete: if canDeleteAssignment();
    }

    match /solicitudes_compartidas/{requestId} {
      allow read: if canReadSharedRequests();

      allow create: if canReadSharedRequests()
        && request.resource.data.status == 'PENDIENTE';

      allow update: if canReadSharedRequests();

      allow delete: if false;
    }

    match /solicitudes_sistemas/{requestId} {
      allow read: if isSystemsMember()
        || (
          isActiveUser()
          && resource.data.requestedBy == request.auth.uid
        );

      allow create: if canCreateSystemRequest();

      allow update: if isSystemsMember()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.requestedBy == resource.data.requestedBy;

      allow delete: if isSystemsMember()
        || hasModuleAccess('solicitudes');
    }

    match /bitacora/{entryId} {
      allow read: if isSystemsMember()
        || hasModuleAccess('bitacora');

      // Las entradas verificadas se generan exclusivamente desde Cloud Functions
      // (Admin SDK). El cliente solo puede conservar eventos transitorios
      // identificados expresamente como no verificados durante la migracion.
      allow create: if isActiveUser()
        && request.resource.data.source == 'CLIENTE'
        && request.resource.data.integrity == 'NO_VERIFICADO'
        && request.resource.data.createdAt is string;
      allow update, delete: if false;
    }

    match /ligas_meet/{meetLinkId} {
      allow read: if canReadMeetLinks();

      allow create: if canEditMeetLinks()
        && isValidMeetLinkDocument(meetLinkId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if canEditMeetLinks()
        && isValidMeetLinkDocument(meetLinkId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if canEditMeetLinks();
    }

    match /moodle_categorias/{categoryId} {
      allow read: if canReadMoodleCatalogs();
      allow create, update: if canEditMoodleCatalogs()
        && request.resource.data.categoryNumber is string
        && request.resource.data.programCode is string
        && request.resource.data.programName is string
        && request.resource.data.status in ['Activo', 'Inactivo'];
      allow delete: if canEditMoodleCatalogs();
    }

    match /moodle_plantillas/{templateId} {
      allow read: if canReadMoodleCatalogs();
      allow create, update: if canEditMoodleCatalogs()
        && request.resource.data.templateCourse is string
        && request.resource.data.name is string
        && request.resource.data.modality is string
        && request.resource.data.programCode is string
        && request.resource.data.status in ['Activo', 'Inactivo'];
      allow delete: if canEditMoodleCatalogs();
    }

    match /configuracion/{configId} {
      allow read: if canReadInstitutionalCatalogs();

      allow create, update: if (
          configId == 'docentes'
          && (
            canEditTeachers()
            || (
              isActiveUser()
              && hasModuleAccess('docentes')
            )
          )
          && request.resource.data.lastMoodleTeacherNumber is int
        )
        || (
          configId == 'notificaciones_asignaciones'
          && isSystemsMember()
          && request.resource.data.enabled is bool
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedByName is string
          && request.resource.data.updatedAt is string
        );

      allow delete: if canEditTeachers();
    }

    match /notificaciones/{notificationId} {
      allow read: if isSystemsMember()
        || (
          isActiveUser()
          && canReadAcademicNotificationTarget()
        );

      allow create: if isActiveUser()
        && request.resource.data.type in [
          'DOCENTE_NUEVO',
          'DOCENTE_VALIDADO',
          'ASIGNACIONES_HITO',
          'CLASE_COMPARTIDA',
          'SOLICITUD_SISTEMAS',
          'AGENDA_EQUIPO',
          'ASIGNACION_MODIFICADA'
        ]
        && (
          request.resource.data.type != 'AGENDA_EQUIPO'
          || isBaseSystemsUser()
        )
        && (
          request.resource.data.target == 'SISTEMAS'
          || (
            request.resource.data.target == 'COORDINACION_ACADEMICA'
            && request.resource.data.targetUserId is string
            && request.resource.data.targetUserId != ''
            && (
              isSystemsMember()
              || request.resource.data.type == 'CLASE_COMPARTIDA'
            )
          )
        );

      allow update: if (
          isSystemsMember()
          || (
            isActiveUser()
            && canReadAcademicNotificationTarget()
          )
        )
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['readBy']);

      allow delete: if false;
    }

    match /agenda_operativa_equipo/{activityId} {
      allow read: if isBaseSystemsUser();

      allow create: if isBaseSystemsUser()
        && request.resource.data.scope == 'EQUIPO'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.column is string
        && request.resource.data.priority is string;

      allow update: if isBaseSystemsUser()
        && request.resource.data.scope == 'EQUIPO'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isBaseSystemsUser();
    }

    match /agenda_operativa_privada/{ownerId}/actividades/{activityId} {
      allow read: if isBaseSystemsUser() && ownerId == request.auth.uid;

      allow create: if isBaseSystemsUser()
        && ownerId == request.auth.uid
        && request.resource.data.scope == 'PRIVADA'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.column is string
        && request.resource.data.priority is string;

      allow update: if isBaseSystemsUser()
        && ownerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.scope == 'PRIVADA'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isBaseSystemsUser()
        && ownerId == request.auth.uid
        && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
