  function inProgram(program) { return within('programs', program); }
  function inCycle(cycle) { return within('cycles', cycle); }
  function delegatedFields() { return general() || user().get('scope', {}).get('fields', []).hasAny(['*']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(user().get('scope', {}).get('fields', []).concat(['updatedAt', 'updatedBy', 'updatedByName', 'updatedByRole'])); }
  function protectedIdentity() { return resource == null ? false : resource.data.get('deletedAt', null) != null ? false : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'updatedAt']) && resource.data.get('authUid', null) == null && request.resource.data.get('authUid', '') == request.auth.uid && resource.data.get('email', '') == request.auth.token.email && request.auth.token.get('email_verified', false) == true; }
  function bootstrap(userId) {
